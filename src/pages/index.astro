---
import Layout from '../layouts/Layout.astro';
import Artwork from '../components/Artwork.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { getPosts } from '../lib/posts';
import { categories } from '../lib/blog.mjs';
const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const otherPosts = posts.filter((post) => post.id !== featured?.id);
---
<Layout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow"><span class="little-star">✳</span> HELLO, WELCOME TO MY CORNER</div>
      <h1 id="hero-title">A curious mind.<br />An open <span class="underlined">notebook.</span></h1>
      <p class="hero-intro">I’m {site.name} <span class="intro-dash">—</span> nice to meet you.<br />{site.introduction}</p>
      <div class="hero-actions"><a class="button button-primary" href="#notebook">Explore the notebook <Icon name="arrow" size={17} /></a><a class="text-link" href="/about/">A little about me <Icon name="external" size={17} /></a></div>
    </div>
    <div class="hero-visual"><span class="visual-eyebrow">THOUGHTS, IDEAS & LITTLE DISCOVERIES</span><Artwork variant="notebook" hero /></div>
  </section>
  <div class="container section-rule"><span><span class="status-dot"></span> A work in progress, in the best way.</span><span class="rule-note">Less noise. More curiosity.</span></div>
  <section class="container notebook-section" id="notebook" aria-labelledby="notebook-title">
    <div class="section-heading"><div><span class="eyebrow">THE LATEST FROM MY DESK</span><h2 id="notebook-title">The notebook<span class="heading-dot">.</span></h2></div><span class="post-count">{posts.length} notes & counting</span></div>
    <div class="notebook-layout">
      <div class="notebook-main">
        <div class="browse-controls" data-browse-controls hidden>
          <div class="category-filters" role="group" aria-label="Filter posts by topic">{categories.map((category) => <button type="button" data-filter={category} aria-pressed={category === 'All posts'}>{category}</button>)}</div>
          <label class="search-box"><Icon name="search" size={17} /><span class="sr-only">Search blog posts</span><input type="search" id="post-search" placeholder="Find a note…" autocomplete="off" /></label>
        </div>
        <p class="sr-only" data-results-status role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="posts-grid" data-posts-grid>
          {featured && <PostCard post={featured} featured />}
          {otherPosts.map((post) => <PostCard post={post} />)}
        </div>
        <div class="empty-state" data-empty-state hidden><Icon name="search" size={30} /><h3>No notes found. Yet.</h3><p>Try another search or take a look at all the posts.</p><button class="button button-outline" type="button" data-reset>Reset filters <Icon name="arrow" size={16} /></button></div>
        {!posts.length && <p class="muted">The first note is on its way. Check back soon.</p>}
        <p class="endnote"><span>✳</span> That’s the notebook so far. More pages to come.</p>
      </div>
      <aside class="notebook-sidebar" aria-label="About the author and follow options">
        <div class="profile-card"><div class="profile-top"><span class="avatar">cx<span>✳</span></span><span class="tiny-label">THE PERSON<br />BEHIND THE NOTES</span></div><h3>Hey, I’m {site.name}.</h3><p>{site.bio}</p><a class="text-link" href="/about/">Get to know me <Icon name="arrow" size={16} /></a><div class="profile-divider"></div><span class="tiny-label">THINGS YOU’LL FIND HERE</span><ul class="interest-list"><li><Icon name="code" size={16} /> Code & experiments</li><li><Icon name="book" size={16} /> Ideas worth keeping</li><li><Icon name="sun" size={16} /> Life between the lines</li></ul><a class="github-link" href={site.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={17} /> Find me on GitHub <Icon name="external" size={16} /></a></div>
        <div class="subscribe-card"><span class="subscribe-icon"><Icon name="rss" size={21} /></span><h3>Good thoughts.<br />No algorithm.</h3><p>New notes, straight to your favorite feed reader. At your own pace.</p><a class="button button-subscribe" href="/subscribe/">Follow the notebook <Icon name="arrow" size={16} /></a><span class="subscribe-footnote">Just a quiet way to stay in the loop.</span></div>
      </aside>
    </div>
  </section>
</Layout>
<script>
  import { matchesPost, categories } from '../lib/blog.mjs';
  const controls = document.querySelector<HTMLElement>('[data-browse-controls]');
  const search = document.querySelector<HTMLInputElement>('#post-search');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');
  const grid = document.querySelector<HTMLElement>('[data-posts-grid]');
  const status = document.querySelector<HTMLElement>('[data-results-status]');
  let category = 'All posts';
  if (controls && search) {
    controls.hidden = false;
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') ?? '';
    const initialCategory = params.get('topic');
    if (initialCategory && categories.includes(initialCategory)) category = initialCategory;
    const update = (saveUrl = true) => {
      let count = 0;
      for (const card of cards) {
        const matches = matchesPost({
          title: card.dataset.title ?? '', description: card.dataset.description ?? '',
          category: card.dataset.category ?? '', tags: JSON.parse(card.dataset.tags ?? '[]'),
        }, search.value, category);
        card.hidden = !matches;
        if (matches) count++;
      }
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === category)));
      if (empty) empty.hidden = count > 0;
      if (grid) grid.classList.toggle('is-filtered', category !== 'All posts' || search.value.trim() !== '');
      if (status) status.textContent = `${count} ${count === 1 ? 'note' : 'notes'} found${category !== 'All posts' ? ` in ${category}` : ''}.`;
      if (saveUrl) {
        const url = new URL(location.href);
        if (search.value.trim()) url.searchParams.set('q', search.value.trim()); else url.searchParams.delete('q');
        if (category !== 'All posts') url.searchParams.set('topic', category); else url.searchParams.delete('topic');
        history.replaceState(null, '', url);
      }
    };
    search.addEventListener('input', () => update());
    buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.filter ?? 'All posts'; update(); }));
    document.querySelector('[data-reset]')?.addEventListener('click', () => { category = 'All posts'; search.value = ''; update(); search.focus(); });
    update(false);
  }
</script>